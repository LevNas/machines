[user]
	name = {{ onepasswordRead "op://Personal/git-config/username" | trim | quote }}
	email = {{ onepasswordRead "op://Personal/git-config/email" | trim | quote }}
	signingkey = {{ onepasswordRead "op://Personal/git-config/signing-key" | trim | quote }}
[init]
	defaultBranch = main
[pull]
	rebase = false
[fetch]
	prune = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
{{- if eq .osType "linux" }}
	program = /run/current-system/sw/bin/op-ssh-sign
{{- else if eq .osType "windows" }}
	program = C:/Users/{{ onepasswordRead "op://Personal/git-config/username" | trim }}/AppData/Local/1Password/app/8/op-ssh-sign.exe
{{- else if eq .osType "macos" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
[ghq]
	root = ~/src
{{- /* ccguard's pre-push gate checks where and what Claude Code pushes (active only
     when CLAUDECODE=1; each hook chains to the repo's own .git/hooks/<name>).
     Set only where the ccguard plugin has created the directory: a global
     core.hooksPath pointing at a missing directory would silently disable every
     repository's own hooks. */}}
{{- if stat (joinPath .chezmoi.homeDir ".local/share/ccguard/git-hooks") }}
[core]
	hooksPath = ~/.local/share/ccguard/git-hooks
{{- end }}
